direction: down

classes: {
  start: { style: { fill: "#fef08a"; stroke: "#ca8a04"; stroke-width: 2; font-color: "#0a0f25" } }
  decision: { style: { fill: "#fed7aa"; stroke: "#ea580c"; stroke-width: 2; font-color: "#0a0f25" } }
  dcr: { style: { fill: "#bfdbfe"; stroke: "#2563eb"; stroke-width: 2; font-color: "#0a0f25" } }
  cimd: { style: { fill: "#bbf7d0"; stroke: "#16a34a"; stroke-width: 2; font-color: "#0a0f25" } }
  either: { style: { fill: "#e9d5ff"; stroke: "#7c3aed"; stroke-width: 2; font-color: "#0a0f25" } }
}

START: "Can this client host a\nstable HTTPS URL?" {shape: diamond; class: start}
Q2: "Are the target ASes many,\nor not known in advance?" {shape: diamond; class: decision}
DCR2: "DCR\n(or pre-registration)" {class: dcr}
CIMD2: "CIMD fits\nBluesky / Solid / MCP" {class: cimd}
EITHER: "Either works\npre-registration is simplest" {class: either}

START -> Q2: "Yes (web app, etc.)"
START -> DCR2: "No (CLI / desktop / native)"
Q2 -> CIMD2: "Yes (open mesh)"
Q2 -> EITHER: "No (fixed partner)"
