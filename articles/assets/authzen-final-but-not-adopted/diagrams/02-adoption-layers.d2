    style: { fill: "#ffffff"; stroke: "#F9AB00"; font-color: "#0a0f25" }
  }
  n2: "search シナリオ\n9実装\n評価方向が逆転して被せられない" {
    style: { fill: "#ffffff"; stroke: "#F9AB00"; font-color: "#0a0f25" }
  }
  n3: "適合性認証\n0実装\nプログラム自体が未リリース" {
    style: { fill: "#ffffff"; stroke: "#F9AB00"; font-color: "#0a0f25" }
  }
}

