}
l3: "3. resource schema layer (contents, Envoy-specific)" {
  style.fill: "#dcfce7"; style.stroke: "#15803d"; style.font-color: "#14532d"
  r: "envoy.config.listener.v3.Listener\nCluster / RouteConfiguration / ...\nwhat a Listener looks like" { style.fill: "#bbf7d0"; style.stroke: "#15803d"; style.font-color: "#14532d" }
