direction: down

classes: {
  step: { style: { fill: "#E8F0FE"; stroke: "#4285F4"; font-color: "#0a0f25"; font-size: 20 } }
  gap: { style: { fill: "#FEF7E0"; stroke: "#F9AB00"; stroke-dash: 4; font-color: "#0a0f25"; font-size: 20 } }
  rej: { style: { fill: "#FCE8E6"; stroke: "#D93025"; font-color: "#0a0f25"; font-size: 18 } }
  ok: { style: { fill: "#E6F4EA"; stroke: "#34A853"; font-color: "#0a0f25"; font-size: 20 } }
}

flow: "" {
  grid-rows: 10
  grid-columns: 2
  horizontal-gap: 70
  vertical-gap: 55
  style: { fill: transparent; stroke: transparent }
  in: "Workload-Identity-Token: eyJhbGci...\nAuthorization: WPT eyJ...   (or Signature + wimse-aud)" { class: ok; style.font: mono }
  blank0: "" { style: { fill: transparent; stroke: transparent } }
  s1: "1. one JWS compact JWT?\n(3 base64url parts, no padding, no JSON serialization)" { class: step }
  r1: "400" { class: rej }
  s2: "2. sub = exactly one Workload Identifier?\ntrust domain = its authority, e.g. example.com\nlook it up in the PRECONFIGURED map (Section 3)" { class: step }
  r2: "400: no anchors for this domain\n(no discovery fallback)" { class: rej }
  s3: "3. typ = wit+jwt ?" { class: step }
  r3: "400" { class: rej }
  s4: "4. signature valid under that domain's anchors?\nkid picks the key; no kid = deployment policy\niss is never dereferenced (9.1)" { class: step }
  r4: "400: bad sig / unknown kid" { class: rej }
  s5: "5. cnf.jwk present with alg?\nalg asymmetric, not none / HMAC / encryption (5.1)" { class: step }
  r5: "400" { class: rej }
  s6: "6. unknown claims: ignore" { class: step }
  blank6: "" { style: { fill: transparent; stroke: transparent } }
  g1: "not in 5.1.3, still on you:\nexp (MUST exist; 5.3 calls expiry an error)\niss present but != configured issuer (unspecified)" { class: gap }
  blank7: "" { style: { fill: transparent; stroke: transparent } }
  p1: "PoP layer (wpt / http-signature drafts):\nproof alg == cnf.jwk.alg\naudience == ME from trusted config, never Host (5.2)\nshort lifetime, replay check (9.3.2-9.3.4)" { class: step }
  rp: "reject: wrong audience,\nexpired or replayed proof" { class: rej }
  p2: "authorize on the FULL identifier in its trust domain (7)\npassing 1-6 only proves domain membership (9.2)" { class: ok }
  blank9: "" { style: { fill: transparent; stroke: transparent } }
  in -> s1
  s1 -> s2: yes
  s2 -> s3: yes
  s3 -> s4: yes
  s4 -> s5: yes
  s5 -> s6: yes
  s6 -> g1
  g1 -> p1
  p1 -> p2: ok
  s1 -> r1: no
  s2 -> r2: no
  s3 -> r3: no
  s4 -> r4: no
  s5 -> r5: no
  p1 -> rp: no
}
