direction: right
scalar: "bool (scalar)" {
  style.fill: "#fee2e2"; style.stroke: "#b91c1c"; style.font-color: "#7f1d1d"
  s1: "false\nunset? explicit false?\ncannot tell" { style.fill: "#fecaca"; style.stroke: "#b91c1c"; style.font-color: "#7f1d1d" }
}
wrapper: "BoolValue (wrapper)" {
  style.fill: "#dcfce7"; style.stroke: "#15803d"; style.font-color: "#14532d"
  w1: "nil = unset" { style.fill: "#bbf7d0"; style.stroke: "#15803d"; style.font-color: "#14532d" }
  w2: "{value: false} = explicit false" { style.fill: "#bbf7d0"; style.stroke: "#15803d"; style.font-color: "#14532d" }
  w3: "{value: true} = explicit true" { style.fill: "#bbf7d0"; style.stroke: "#15803d"; style.font-color: "#14532d" }
}
