direction: right

b1: "ユーザーがサーバの数だけ同意画面を踏む" {
  style: { fill: "#FCE8E6"; stroke: "#D93025"; stroke-width: 2; font-color: "#0a0f25" }
}
a1: "IdP に一度 SSO するだけ\nMCP サーバごとの同意はゼロ" {
  style: { fill: "#E6F4EA"; stroke: "#34A853"; stroke-width: 2; font-color: "#0a0f25" }
}

b2: "トークンが切れるたびにまた踏む" {
  style: { fill: "#FCE8E6"; stroke: "#D93025"; stroke-width: 2; font-color: "#0a0f25" }
}
a2: "クライアントが無人でトークンを取り直す\nwithout user interaction" {
  style: { fill: "#E6F4EA"; stroke: "#34A853"; stroke-width: 2; font-color: "#0a0f25" }
}

b3: "誰がどのサーバに繋いだか\n管理者から見えない" {
  style: { fill: "#FCE8E6"; stroke: "#D93025"; stroke-width: 2; font-color: "#0a0f25" }
}
a3: "IdP が管理者定義のポリシーを評価する\n仕様 4.1 Processing Rules" {
  style: { fill: "#E6F4EA"; stroke: "#34A853"; stroke-width: 3; font-color: "#0a0f25" }
}

b4: "「このサーバは禁止」を強制できない\n退職者を一括失効できない" {
  style: { fill: "#FCE8E6"; stroke: "#D93025"; stroke-width: 2; font-color: "#0a0f25" }
}
a4: "どの MCP サーバを組織内で使えるか\n管理者が決める" {
  style: { fill: "#E6F4EA"; stroke: "#34A853"; stroke-width: 2; font-color: "#0a0f25" }
}

b1 -> a1: "置き換わる"
b2 -> a2: "置き換わる"
b3 -> a3: "置き換わる"
b4 -> a4: "置き換わる"
