direction: right

classes: {
  q: {
    style: {
      fill: "#fef3c7"
      stroke: "#b45309"
      stroke-width: 2
      font-color: "#0a0f25"
    }
  }
  inside: {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      stroke-width: 2
      font-color: "#0a0f25"
    }
  }
  oidc: {
    style: {
      fill: "#dbeafe"
      stroke: "#1d4ed8"
      stroke-width: 2
      font-color: "#0a0f25"
    }
  }
  anywhere: {
    style: {
      fill: "#fce7f3"
      stroke: "#be185d"
      stroke-width: 3
      font-color: "#0a0f25"
    }
  }
}

Q1: "Workload runs\ninside or outside AWS?" {
  class: q
  shape: diamond
}
Q2: "What does it run on?" {
  class: q
  shape: diamond
}
Q3: "Who is the caller?" {
  class: q
  shape: diamond
}

A1: "EC2 -> Instance Profile" {class: inside}
A2: "Lambda -> Execution Role" {class: inside}
A3: "ECS/EKS -> Task Role / IRSA / Pod Identity" {class: inside}
A4: "GitHub Actions ->\nOIDC + AssumeRoleWithWebIdentity" {class: oidc}
A5: "GitLab CI / CircleCI / other OIDC IdPs ->\nsame OIDC federation" {class: oidc}
A6: "Already federated to internal\nSAML/OIDC IdP ->\nIAM Identity Center" {class: oidc}
A7: "On-prem server /\nself-hosted K8s cluster /\nVM in another cloud ->\nIAM Roles Anywhere" {class: anywhere}

Q1 -> Q2: "inside"
Q1 -> Q3: "outside"

Q2 -> A1
Q2 -> A2
Q2 -> A3

Q3 -> A4
Q3 -> A5
Q3 -> A6
Q3 -> A7
