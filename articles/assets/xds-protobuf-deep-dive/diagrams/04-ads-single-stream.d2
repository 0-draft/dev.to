direction: right
istiod: "istiod" { style.fill: "#c4b5fd"; style.stroke: "#6d28d9"; style.font-color: "#2e1065" }
stream: "one ADS gRPC stream" {
  style.fill: "#e0e7ff"; style.stroke: "#4338ca"; style.font-color: "#312e81"
  m: "LDS / RDS / CDS / EDS / SDS\nmultiplexed by type_url" { style.fill: "#c7d2fe"; style.stroke: "#4338ca"; style.font-color: "#312e81" }
}
env: "Envoy" { style.fill: "#86efac"; style.stroke: "#15803d"; style.font-color: "#14532d" }
istiod -> stream.m
stream.m -> env
