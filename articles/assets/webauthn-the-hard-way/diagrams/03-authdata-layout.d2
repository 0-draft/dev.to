direction: down

title: "authenticatorData byte layout\n(37 bytes固定 + 可変)" {
  shape: text
  style.font-size: 18
}

rp_hash: "rpIdHash\n32 bytes\nSHA-256(rp.id)" {
  style.fill: "#fef3c7"
}

flags: "flags\n1 byte\nUP / UV / BE / BS / AT / ED" {
  style.fill: "#dbeafe"
}

count: "signCount\n4 bytes (big-endian)" {
  style.fill: "#dcfce7"
}

aaguid: "AAGUID\n16 bytes\n(present if AT)" {
  style.fill: "#fce7f3"
}

credlen: "credIdLength\n2 bytes (big-endian)\n(present if AT)" {
  style.fill: "#fce7f3"
}

credid: "credentialId\nvariable\n(present if AT)" {
  style.fill: "#fce7f3"
}

cose: "credentialPublicKey\nCOSE_Key (CBOR)\n(present if AT)" {
  style.fill: "#fce7f3"
}

ext: "extensions\nCBOR map\n(present if ED)" {
  style.fill: "#e0e7ff"
}

title -> rp_hash
rp_hash -> flags
flags -> count
count -> aaguid
aaguid -> credlen
credlen -> credid
credid -> cose
cose -> ext
