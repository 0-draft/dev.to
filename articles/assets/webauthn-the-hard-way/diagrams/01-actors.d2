direction: right

user: User\n(人間) {
  shape: person
  style.fill: "#fef3c7"
}

browser: Browser\n(navigator.credentials.*) {
  shape: rectangle
  style.fill: "#dbeafe"
}

authenticator: Authenticator\n(Touch ID / Windows Hello / YubiKey) {
  shape: rectangle
  style.fill: "#fce7f3"
}

rp: Relying Party\n(localhost:5000\n our Flask server) {
  shape: rectangle
  style.fill: "#dcfce7"
}

user -> browser: "1. click Register"
browser -> rp: "2. POST /register/begin"
rp -> browser: "3. challenge + rp + user"
browser -> authenticator: "4. WebAuthn API\nnavigator.credentials.create()"
authenticator -> user: "5. consent (Touch ID / PIN)"
authenticator -> browser: "6. attestationObject + clientDataJSON"
browser -> rp: "7. POST /register/complete"
rp -> rp: "8. parse CBOR / COSE,\nverify attestation"
