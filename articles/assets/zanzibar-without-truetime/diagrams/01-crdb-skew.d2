grid-rows: 1
grid-gap: 60

no: "--datastore-tx-overlap-strategy=insecure" {
  shape: sequence_diagram
  app: "Anne's app"
  n1: "node 1\nclock +250 ms"
  n2: "node 2\nclock on time"
  chk: "Chen's check"

  app -> n1: "x: DELETE folder:A#viewer@user:chen\n(real time 10.000)"
  n1."commit x @ 10.250" { style: { fill: "#FEF7E0"; stroke: "#E37400"; font-color: "#0a0f25" } }
  n1 -> app: "ok" { style.stroke-dash: 4 }
  app -> n2: "y: TOUCH document:readme#parent@folder:A\n(real time 10.100)"
  n2."commit y @ 10.100\nno key in common with x" { style: { fill: "#FDE2E1"; stroke: "#C5221F"; font-color: "#0a0f25" } }
  n2 -> app: "written_at = 10.100" { style.stroke-dash: 4 }
  app -> chk: "at_least_as_fresh 10.100"
  chk."snapshot 10.100 has y, not x\nPERMISSIONSHIP_HAS_PERMISSION" { style: { fill: "#FDE2E1"; stroke: "#C5221F"; font-color: "#0a0f25" } }
}

yes: "--datastore-tx-overlap-strategy=static (default)" {
  shape: sequence_diagram
  app: "Anne's app"
  n1: "node 1\nclock +250 ms"
  n2: "node 2\nclock on time"
  chk: "Chen's check"

  app -> n1: "x: DELETE ... + UPSERT transactions(key='key')"
  n1."commit x @ 10.250\nrow 'key' now at 10.250" { style: { fill: "#FEF7E0"; stroke: "#E37400"; font-color: "#0a0f25" } }
  n1 -> app: "ok" { style.stroke-dash: 4 }
  app -> n2: "y: TOUCH ... + UPSERT transactions(key='key')"
  n2."write-write conflict on 'key':\ntimestamp pushed above 10.250\ncommit y @ 10.251" { style: { fill: "#E6F4EA"; stroke: "#188038"; font-color: "#0a0f25" } }
  n2 -> app: "written_at = 10.251" { style.stroke-dash: 4 }
  app -> chk: "at_least_as_fresh 10.251"
  chk."snapshot 10.251 has x and y\nPERMISSIONSHIP_NO_PERMISSION" { style: { fill: "#E6F4EA"; stroke: "#188038"; font-color: "#0a0f25" } }
}
