direction: down

Internet: "Internet" {
  shape: cylinder
  style.fill: "#bbdefb"
  style.stroke: "#1976d2"
  style.font-color: "#0a0f25"
}

FW: "Perimeter Firewall" {
  style.fill: "#ffcdd2"
  style.stroke: "#c62828"
  style.stroke-width: 3
  style.font-color: "#0a0f25"
}

LAN: "Internal LAN (trusted zone)" {
  style.fill: "#e8f5e9"
  style.stroke: "#388e3c"
  style.stroke-width: 2
  style.font-color: "#0a0f25"
  direction: right

  Web: "Web Server"
  App: "App Server"
  DB: "Database" { shape: cylinder }
  Print: "Printer"
  PC: "Employee PC"

  Web <-> App
  App <-> DB
  PC <-> Print
  PC <-> Web
}

Internet -> FW: "South to North"
FW -> LAN
