// Mirrors ~/.markdownlint-cli2.jsonc so CI enforces the same rules the author
// lints with locally. Without a config in the repo, markdownlint on the runner
// falls back to its defaults, which enables MD013 (line-length). That directly
// contradicts this repo's house rule that a paragraph is one unwrapped line,
// and would make every new article unable to pass the lint ratchet.
//
// MD010 is the one deliberate addition on top of the global file: gofmt indents
// with tabs, so every Go sample in the corpus is a "hard tab" violation (153 of
// them). Tabs in prose are still flagged.
{
  "config": {
    "default": true,
    "MD010": { "code_blocks": false },
    "MD013": false,
    "MD024": false,
    "MD033": { "allowed_elements": ["picture", "source", "img"] },
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  "ignores": [
    "node_modules/**",
    ".venv/**"
  ]
}
