direction: down

classes: {
  ee: {
    style: {
      fill: "#fef3c7"
      stroke: "#b45309"
      stroke-width: 2
      font-color: "#0a0f25"
    }
  }
  ca: {
    style: {
      fill: "#dbeafe"
      stroke: "#1d4ed8"
      stroke-width: 2
      font-color: "#0a0f25"
    }
  }
  anchor: {
    style: {
      fill: "#fce7f3"
      stroke: "#be185d"
      stroke-width: 3
      font-color: "#0a0f25"
    }
  }
}

EE: "End-entity certificate\nfor server A" {class: ee}
Intermediate: "Intermediate CA certificate" {class: ca}
Root: "Root CA certificate\n= registered as Trust Anchor" {class: anchor}
TAref: "Trust Anchor\n= reference to the Root CA" {class: anchor}

EE -> Intermediate: "signed by"
Intermediate -> Root: "signed by"
Root -> TAref: "registered as" {style.stroke-dash: 3}
